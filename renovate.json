{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": false,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Group TanStack packages",
      "matchPackageNames": ["@tanstack/**"],
      "groupName": "TanStack"
    },
    {
      "description": "Group Cloudflare packages",
      "matchPackageNames": ["@cloudflare/**", "wrangler"],
      "groupName": "Cloudflare"
    },
    {
      "description": "Group Biome and Ultracite",
      "matchPackageNames": ["@biomejs/**", "ultracite"],
      "groupName": "Biome and Ultracite"
    },
    {
      "description": "Group Vitest packages",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "groupName": "Vitest"
    },
    {
      "description": "Group Playwright packages",
      "matchPackageNames": ["playwright", "playwright-core", "@playwright/**"],
      "groupName": "Playwright"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Counter of the cards patches internals of number-flow (willUpdate, didUpdate, attachShadow); a bump needs a human, and contador.e2e.ts catches the rest",
      "matchPackageNames": ["@number-flow/**", "number-flow"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}

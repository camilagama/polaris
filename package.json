{
  "name": "polaris",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "boundaries": "node scripts/verify-import-boundaries.mjs && node scripts/verify-no-import-cycles.mjs",
    "build": "turbo run build",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run boundaries && bun run migrations:compat && bun run knip && bun run test",
    "dev": "turbo run dev --filter=@polaris/web",
    "fix": "ultracite fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "lint": "biome lint .",
    "migrations:compat": "node scripts/verify-migration-compat.mjs",
    "test": "vitest run",
    "tokens:generate": "node scripts/generate-color-tokens.mjs",
    "typecheck": "turbo run typecheck",
    "verify:staging-isolation": "node scripts/verify-staging-isolation.mjs"
  },
  "overrides": {
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.5",
    "@types/node": "24",
    "knip": "^6.39.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "24.x"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polaris-web",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "vars": {
    "DB_POC_ENABLED": "false",
    "DB_RLS_POC_ENABLED": "false",
    "EMAIL_PASSWORD_AUTH_ENABLED": "false",
    "AUTH_ABUSE_PROTECTION_ENABLED": "false"
  },
  "main": "./worker/index.ts",
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    },
    {
      "binding": "ONBOARDING_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    }
  ],
  // Reserve unique account-level namespace IDs before deploying these bindings.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "901016",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AUTH_EMAIL_RATE_LIMITER",
      "namespace_id": "901017",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/ready", "/rpc/*", "/api/*"]
  }
}

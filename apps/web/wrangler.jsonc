{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The top level is for local development only (`vite dev`, tests). Every binding below is local:
  // Hyperdrive ids are `local-only` and the queue and bucket names end in `-local`, so a deploy that
  // forgets `CLOUDFLARE_ENV`/`--env` fails instead of publishing anything. What is deployed lives in
  // `env.staging` (the fixed staging of this account, ADR 0097) and `env.production` (the go-live,
  // in a separate account). Bindings, vars and secrets are not inherited by an environment, so each
  // one repeats all of them; `scripts/verify-staging-isolation.mjs` checks the parity and the isolation.
  "name": "polaris-web-local",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EMAIL_PASSWORD_AUTH_ENABLED": "false",
    "AUTH_ABUSE_PROTECTION_ENABLED": "false",
    // the Woovi refund command stays off until the refund of an installment is proven (S3.2, Gate 7)
    "WOOVI_REFUND_ENABLED": "false",
    // the automatic purge of a closed organization (ADR 0102): off until the go-live
    "CLOSURE_AUTO_PURGE_ENABLED": "false",
    // the e-mail of the closure notices (ADR 0102, amended): off until the responsible turns it on
    "CLOSURE_NOTICE_EMAIL_ENABLED": "false",
    // the owner's billing self-service (ADR 0104): off until the screens, the e-mails and the Gate 7 are in
    "BILLING_SELF_SERVICE_ENABLED": "false",
    // the support box of the billing e-mails, their footer and reply-to (ADR 0104): empty on purpose until the
    // responsible sets it; without it the billing e-mails and the welcome stay off (their notices are skipped)
    "BILLING_SUPPORT_EMAIL": "",
    "WELCOME_EMAIL_ENABLED": "false",
    // the server control of the legal acceptance (ADR 0100): off until the client that pauses the sync
    // on it is published and the service worker had time to update every device (release checklist)
    "LEGAL_ACCEPTANCE_ENFORCED": "false"
  },
  "main": "./worker/index.ts",
  // Structured logger output (see src/server/observability).
  // Production defaults (ADR 0094); each environment repeats the whole block.
  // Logs stay at 100% because the platform samples a request as a whole and has no separate rate for errors:
  // lowering the rate would drop error events with the rest. Invocation logs are off, so only our own
  // structured events are stored (ADR 0094 lists what that drops). Traces are the sampled part: 5%.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // The ids below only serve local development. Deployed Workers need real
  // Hyperdrive configurations with query caching disabled:
  // - HYPERDRIVE: tenant role (RLS, no access to the auth tables)
  // - AUTH_HYPERDRIVE: Better Auth role (DML only on user/account/session/verification, plus the functions of the sign-in lock
  //   and the one that reads the address of a closure notice, closure_notice_recipient, the one of a billing notice,
  //   billing_notice_recipient, and the one that deletes the users never verified, purge_unverified_users)
  // - OUTBOX_HYPERDRIVE: outbox role (dispatcher and queue processing record, functions only; ADR 0084)
  // - BILLING_HYPERDRIVE: billing role (webhooks, the sweep and the billing notices, which it reads owed and marks
  //   once: a cached read would send a notice twice)
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    },
    {
      "binding": "AUTH_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    },
    {
      "binding": "ONBOARDING_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    },
    {
      "binding": "MEDIA_CLEANUP_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    },
    {
      "binding": "PRIVACY_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    },
    {
      "binding": "BILLING_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    },
    {
      "binding": "OUTBOX_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "polaris-media-local"
    }
  ],
  // Rate limit namespace ids are per account: 900xxx is local, 902xxx staging, 901xxx production.
  // /rpc counts writes in RPC_MUTATION_RATE_LIMIT (per session and per address) and reads in a bucket of
  // their own: RPC_READ_RATE_LIMIT per session and RPC_READ_IP_RATE_LIMIT per address, wider because a
  // whole store shares one address. Reads and writes come from the `kind` of each procedure in the contract.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "900016",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AUTH_EMAIL_RATE_LIMITER",
      "namespace_id": "900017",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "RPC_MUTATION_RATE_LIMIT",
      "namespace_id": "900018",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RPC_READ_RATE_LIMIT",
      "namespace_id": "900021",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "RPC_READ_IP_RATE_LIMIT",
      "namespace_id": "900022",
      "simple": { "limit": 1800, "period": 60 }
    },
    {
      "name": "MEDIA_UPLOAD_RATE_LIMIT",
      "namespace_id": "900019",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AUTH_SOCIAL_RATE_LIMITER",
      "namespace_id": "900020",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // The three queues of the plan and the dead-letter queue (ADR 0083, ADR 0085, runbook docs/runbooks/queues.md). Declaring them here
  // creates nothing in the account: `wrangler dev` and the Vite plugin simulate them locally, and a
  // deploy needs the queues to exist first (`wrangler queues create`, a step of the responsible).
  // The outbox dispatcher (ADR 0084) sends from its own cron; the consumer builds the data exports. The Workers Free
  // plan has 10,000 queue operations a day and keeps a message for 24 hours; a message costs at
  // least three operations (write, read, delete), and every retry another read.
  "queues": {
    "producers": [
      { "binding": "QUEUE_CRITICAL", "queue": "polaris-critical-local" },
      { "binding": "QUEUE_DEFAULT", "queue": "polaris-default-local" },
      { "binding": "QUEUE_MEDIA", "queue": "polaris-media-local" },
      // the dead-letter queue (ADR 0085): the consumer sends a notice here for a message it refuses for good
      { "binding": "QUEUE_DLQ", "queue": "polaris-dlq-local" }
    ],
    // One message per invocation and one invocation at a time: the handlers are heavy (a data export builds
    // archives) and a dead invocation then repeats one message, not ten. A message that fails max_retries
    // times is moved by the platform to the dead-letter queue (ADR 0085), whose consumer turns it into an operational
    // incident; the dead-letter queue itself has no dead-letter queue, so its consumer retries for a long time.
    // The environments repeat these settings with their own queue names.
    "consumers": [
      {
        "queue": "polaris-critical-local",
        "dead_letter_queue": "polaris-dlq-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "retry_delay": 30
      },
      {
        "queue": "polaris-default-local",
        "dead_letter_queue": "polaris-dlq-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "retry_delay": 30
      },
      {
        "queue": "polaris-media-local",
        "dead_letter_queue": "polaris-dlq-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "retry_delay": 60
      },
      {
        "queue": "polaris-dlq-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60
      }
    ]
  },
  // One Cron Trigger per scheduler lane, not per job (ADR 0086; the Free plan allows five per account):
  // "17 * * * *" is the maintenance lane (media, billing and privacy) and "19 * * * *" the outbox lane
  // (the dispatcher, ADR 0084), an invocation of its own because the Free plan gives each one 10 ms of
  // CPU. A test keeps this list equal to the lanes of @polaris/domain/scheduling/scheduled-jobs.
  // The environments inherit it (triggers are inheritable), so the list exists once.
  "triggers": {
    "crons": ["17 * * * *", "19 * * * *"]
  },
  // The Worker also runs first for /assets/*: the single-page fallback would answer a chunk that does not exist
  // with the shell (200 text/html), and `import()` and the service worker took it for the chunk (src/server/built-assets.ts).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/ready", "/rpc/*", "/api/*", "/assets/*"]
  },
  "env": {
    // The fixed staging of this account (ADR 0097): synthetic data only, Google sign-in in Testing
    // mode (test users only), password sign-in on for tests (user decision of 22/10, ADR 0100). The ids below
    // are those of the staging resources; the isolation check refuses a PLACEHOLDER, so a resource not created yet blocks the deploy.
    "staging": {
      "name": "polaris-web-staging",
      "account_id": "9c133cfac44a3bcabc02b7cf8b5f6618",
      // Served at dash.araute.app by a Custom Domain created outside this file (ADR 0097, runbook staging.md):
      // no `routes` here, so the deploy token needs no zone permission and a deploy leaves the domain alone.
      // workers.dev is off because the origin check accepts one origin only (BETTER_AUTH_BASE_URL).
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "POLARIS_ENVIRONMENT": "staging",
        // Open to anyone on purpose: the staging data is synthetic. The sender must be on araute.app
        // (the isolation check refuses another domain). RESEND_API_KEY is a Worker secret (runbook staging.md).
        "EMAIL_PASSWORD_AUTH_ENABLED": "true",
        "AUTH_EMAIL_FROM": "Polaris (staging) <nao-responda@araute.app>",
        // The Turnstile widget `polaris-staging` (managed, hostname dash.araute.app only; runbook staging.md). The site
        // key is public; TURNSTILE_SECRET_KEY is a Worker secret. The protection is on here: without the secret
        // (or with AUTH_ABUSE_PROTECTION_ENABLED off), every password POST answers 503 auth_abuse_protection_unavailable
        // (runbook auth-abuse-protection.md). The isolation check refuses a Cloudflare test key (1x, 2x, 3x prefix).
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFhym3AGtjg2fgH0",
        "AUTH_ABUSE_PROTECTION_ENABLED": "true",
        "WOOVI_REFUND_ENABLED": "false",
        "CLOSURE_AUTO_PURGE_ENABLED": "false",
        "CLOSURE_NOTICE_EMAIL_ENABLED": "false",
        "BILLING_SELF_SERVICE_ENABLED": "false",
        "BILLING_SUPPORT_EMAIL": "",
        "WELCOME_EMAIL_ENABLED": "false",
        "LEGAL_ACCEPTANCE_ENFORCED": "false",
        "BETTER_AUTH_BASE_URL": "https://dash.araute.app",
        "CATALOG_ORIGIN": "https://catalogo.araute.app",
        "OFFLINE_LEASE_KEY_ID": "staging-1",
        // http_request_timed (with isolate.id/seq) on every matched /rpc procedure and named /api route, not only the critical ones:
        // the per-route CPU measure of CPU-1e (ADR 0094, amended 26/10/2026). Staging only; production keeps "false".
        "ROUTE_TIMING_ALL": "true"
      },
      // Staging has little traffic: traces at 100% help the first measurements (ADR 0094).
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false
        },
        "traces": { "enabled": true, "head_sampling_rate": 1 }
      },
      // One configuration per database role, caching disabled, against the staging Neon project only.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "744af3f235954bd1a07c4e1dd4a4a023"
        },
        {
          "binding": "AUTH_HYPERDRIVE",
          "id": "3f3a71d75cef4bfcaed1dffd6d4c0b51"
        },
        {
          "binding": "ONBOARDING_HYPERDRIVE",
          "id": "b11407674f6141478e76f6d614828324"
        },
        {
          "binding": "MEDIA_CLEANUP_HYPERDRIVE",
          "id": "9d2daa8242d847419da5768c8c2c5e0b"
        },
        {
          "binding": "PRIVACY_HYPERDRIVE",
          "id": "f147d30c85c6477abc39bf46f2e40013"
        },
        {
          "binding": "BILLING_HYPERDRIVE",
          "id": "04fc6cc95ba8442cb3d516baf5b94614"
        },
        {
          "binding": "OUTBOX_HYPERDRIVE",
          "id": "25d710da19294161a6706ae2ed19678f"
        }
      ],
      "images": { "binding": "IMAGES" },
      "r2_buckets": [
        { "binding": "MEDIA_BUCKET", "bucket_name": "polaris-media-staging" }
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "902016",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "AUTH_EMAIL_RATE_LIMITER",
          "namespace_id": "902017",
          "simple": { "limit": 3, "period": 60 }
        },
        {
          "name": "RPC_MUTATION_RATE_LIMIT",
          "namespace_id": "902018",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RPC_READ_RATE_LIMIT",
          "namespace_id": "902021",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "RPC_READ_IP_RATE_LIMIT",
          "namespace_id": "902022",
          "simple": { "limit": 1800, "period": 60 }
        },
        {
          "name": "MEDIA_UPLOAD_RATE_LIMIT",
          "namespace_id": "902019",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "AUTH_SOCIAL_RATE_LIMITER",
          "namespace_id": "902020",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "queues": {
        "producers": [
          { "binding": "QUEUE_CRITICAL", "queue": "polaris-critical-staging" },
          { "binding": "QUEUE_DEFAULT", "queue": "polaris-default-staging" },
          { "binding": "QUEUE_MEDIA", "queue": "polaris-media-staging" },
          { "binding": "QUEUE_DLQ", "queue": "polaris-dlq-staging" }
        ],
        "consumers": [
          {
            "queue": "polaris-critical-staging",
            "dead_letter_queue": "polaris-dlq-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 5,
            "retry_delay": 30
          },
          {
            "queue": "polaris-default-staging",
            "dead_letter_queue": "polaris-dlq-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 3,
            "retry_delay": 30
          },
          {
            "queue": "polaris-media-staging",
            "dead_letter_queue": "polaris-dlq-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 3,
            "retry_delay": 60
          },
          {
            "queue": "polaris-dlq-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 10,
            "retry_delay": 60
          }
        ]
      }
    },
    // The go-live (Phase 15, PR133): another Cloudflare account and another Neon organization or
    // project (ADR 0097). Not deployed from this repository yet; the placeholders stay until then.
    "production": {
      "name": "polaris-web",
      "account_id": "PLACEHOLDER-production-account-id",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "POLARIS_ENVIRONMENT": "production",
        "EMAIL_PASSWORD_AUTH_ENABLED": "false",
        // empty on purpose (the parity check wants the name): the sender is set at the go-live, on a verified domain of production
        "AUTH_EMAIL_FROM": "",
        // empty on purpose (the parity check wants the name): the widget of production is created at the go-live
        "TURNSTILE_SITE_KEY": "",
        "AUTH_ABUSE_PROTECTION_ENABLED": "false",
        "WOOVI_REFUND_ENABLED": "false",
        "CLOSURE_AUTO_PURGE_ENABLED": "false",
        "CLOSURE_NOTICE_EMAIL_ENABLED": "false",
        "BILLING_SELF_SERVICE_ENABLED": "false",
        "BILLING_SUPPORT_EMAIL": "",
        "WELCOME_EMAIL_ENABLED": "false",
        "LEGAL_ACCEPTANCE_ENFORCED": "false",
        "BETTER_AUTH_BASE_URL": "https://PLACEHOLDER-production-web-origin",
        "CATALOG_ORIGIN": "https://PLACEHOLDER-production-catalog-origin",
        "OFFLINE_LEASE_KEY_ID": "production-1",
        // the timing of every route is a staging measure (ADR 0094); the isolation check refuses "true" here
        "ROUTE_TIMING_ALL": "false"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false
        },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-tenant"
        },
        {
          "binding": "AUTH_HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-auth"
        },
        {
          "binding": "ONBOARDING_HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-onboarding"
        },
        {
          "binding": "MEDIA_CLEANUP_HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-media-cleanup"
        },
        {
          "binding": "PRIVACY_HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-privacy"
        },
        {
          "binding": "BILLING_HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-billing"
        },
        {
          "binding": "OUTBOX_HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-outbox"
        }
      ],
      "images": { "binding": "IMAGES" },
      "r2_buckets": [
        { "binding": "MEDIA_BUCKET", "bucket_name": "polaris-media" }
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "901016",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "AUTH_EMAIL_RATE_LIMITER",
          "namespace_id": "901017",
          "simple": { "limit": 3, "period": 60 }
        },
        {
          "name": "RPC_MUTATION_RATE_LIMIT",
          "namespace_id": "901018",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RPC_READ_RATE_LIMIT",
          "namespace_id": "901021",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "RPC_READ_IP_RATE_LIMIT",
          "namespace_id": "901022",
          "simple": { "limit": 1800, "period": 60 }
        },
        {
          "name": "MEDIA_UPLOAD_RATE_LIMIT",
          "namespace_id": "901019",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "AUTH_SOCIAL_RATE_LIMITER",
          "namespace_id": "901020",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "queues": {
        "producers": [
          { "binding": "QUEUE_CRITICAL", "queue": "polaris-critical" },
          { "binding": "QUEUE_DEFAULT", "queue": "polaris-default" },
          { "binding": "QUEUE_MEDIA", "queue": "polaris-media" },
          { "binding": "QUEUE_DLQ", "queue": "polaris-dlq" }
        ],
        "consumers": [
          {
            "queue": "polaris-critical",
            "dead_letter_queue": "polaris-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 5,
            "retry_delay": 30
          },
          {
            "queue": "polaris-default",
            "dead_letter_queue": "polaris-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 3,
            "retry_delay": 30
          },
          {
            "queue": "polaris-media",
            "dead_letter_queue": "polaris-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 3,
            "retry_delay": 60
          },
          {
            "queue": "polaris-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 10,
            "retry_delay": 60
          }
        ]
      }
    }
  }
}

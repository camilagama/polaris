{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polaris-web",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "DB_POC_ENABLED": "false" },
  "main": "./worker/index.ts",
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/ready", "/rpc/*", "/api/*"]
  }
}

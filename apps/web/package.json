{
  "name": "@polaris/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "LEGAL_DRAFT_BUILD=1 vite build",
    "build:offline-poc": "vite build --config vite.offline.config.ts --mode offline-poc --outDir dist/offline-poc",
    "check": "bun run typecheck",
    "dev": "vite --host 127.0.0.1",
    "gate7:asaas": "bun scripts/gate7-asaas.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:auth-gate": "bun scripts/test-better-auth-gate.ts",
    "test:e2e-real": "playwright test --config playwright.e2e-real.config.ts",
    "test:gate2-worker": "bun scripts/test-gate2-worker.ts",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:offline-browser": "playwright test --config playwright.offline-poc.config.ts && bun scripts/pwa-browser-tests.ts",
    "test:offline-poc": "playwright test --config playwright.offline-poc.config.ts",
    "test:organization-onboarding-gate": "bun scripts/test-organization-onboarding-gate.ts",
    "test:pwa": "bun scripts/pwa-browser-tests.ts",
    "test:real-devices": "bun real-devices/run.ts",
    "test:visual": "bun scripts/pwa-browser-tests.ts --project=chromium-visual",
    "test:visual:update": "bun scripts/pwa-browser-tests.ts --project=chromium-visual --update-snapshots=changed",
    "test:web:datas": "bun scripts/test-datas.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@orpc/client": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@polaris/billing": "workspace:*",
    "@polaris/contracts": "workspace:*",
    "@polaris/db": "workspace:*",
    "@polaris/domain": "workspace:*",
    "@polaris/http-security": "workspace:*",
    "@polaris/observability": "workspace:*",
    "@sentry/react": "11.8.0",
    "@tanstack/browser-db-sqlite-persistence": "^0.2.30",
    "@tanstack/db": "^0.12.1",
    "@tanstack/offline-transactions": "^1.0.63",
    "@tanstack/react-db": "^0.5.5",
    "@visx/curve": "4.0.0",
    "@visx/event": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/heatmap": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-array": "3.2.4",
    "d3-shape": "3.2.0",
    "date-fns": "4.4.0",
    "hono": "^4.13.0",
    "lucide-react": "1.56.0",
    "motion": "14.3.0",
    "react": "^19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-array": "3.0.3",
    "@types/d3-shape": "3.1.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "browserstack-local": "1.5.16",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "^8.3.3",
    "webdriverio": "10.0.2",
    "wrangler": "4.147.0"
  }
}

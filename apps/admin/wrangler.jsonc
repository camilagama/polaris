{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The top level is for local development only: the Hyperdrive id is `local-only`, so a deploy that
  // forgets `--env` fails. What is deployed lives in `env.production` (ADR 0097). `env.staging` exists
  // for parity and for the isolation check, but the Admin is not exposed in staging: no route, no
  // workers.dev, no Access variables and no database binding, so even an invocation fails closed.
  "name": "polaris-admin-local",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  // Production defaults (ADR 0094); each environment repeats the whole block.
  // Logs stay at 100% because the platform samples a request as a whole and has no separate rate for errors:
  // lowering the rate would drop error events with the rest. Invocation logs are off, so only our own
  // structured events are stored (ADR 0094 lists what that drops). Traces are the sampled part: 5%.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // Only the hostname behind the Access application is meant to reach this Worker.
  "workers_dev": false,
  "preview_urls": false,
  // The Admin is protected by Cloudflare Access, and the Worker verifies the signed
  // token itself (ADR 0070). A deployment without these two variables refuses every
  // request to the API instead of running unverified:
  // - ACCESS_TEAM_DOMAIN: <team>.cloudflareaccess.com
  // - ACCESS_AUDIENCE: the audience tag of the Access application for this Worker
  // The id below only serves local development. A deployed Worker needs a real
  // Hyperdrive configuration with query caching disabled, using the login of the
  // Admin role (a member of polaris_admin_runtime), which reads no table and runs only the Admin functions. Caching must stay off: the audit of every read and reveal is written by the function the query calls.
  // ADMIN_BILLING_HYPERDRIVE (the billing role's login, caching off) is added per environment for the
  // billing commands and for the purge, which reads the renewal first; without it they answer 503 and
  // nothing is written (ADR 0073, ADR 0074).
  "hyperdrive": [
    {
      "binding": "ADMIN_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    }
  ],
  "env": {
    // Not exposed (ADR 0097): the staging workflow does not deploy it, and if it were deployed it would
    // have no public hostname, no ACCESS_* variables (every API request is refused) and no database.
    "staging": {
      "name": "polaris-admin-staging",
      "account_id": "9c133cfac44a3bcabc02b7cf8b5f6618",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "POLARIS_ENVIRONMENT": "staging"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false
        },
        "traces": { "enabled": true, "head_sampling_rate": 1 }
      }
    },
    // The go-live (Phase 15, PR133), in another account, behind its own Access application.
    "production": {
      "name": "polaris-admin",
      "account_id": "PLACEHOLDER-production-account-id",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "POLARIS_ENVIRONMENT": "production",
        "ACCESS_TEAM_DOMAIN": "PLACEHOLDER-production-team.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "PLACEHOLDER-production-access-audience"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false
        },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      },
      "hyperdrive": [
        {
          "binding": "ADMIN_HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-admin"
        },
        {
          "binding": "ADMIN_BILLING_HYPERDRIVE",
          "id": "PLACEHOLDER-production-hyperdrive-billing"
        }
      ]
    }
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polaris-admin",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  // Production defaults (ADR 0094); the staging environment of Phase 14 overrides this whole block with `env.staging`.
  // Logs stay at 100% because the platform samples a request as a whole and has no separate rate for errors:
  // lowering the rate would drop error events with the rest. Invocation logs are off, so only our own
  // structured events are stored (ADR 0094 lists what that drops). Traces are the sampled part: 5%.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // Only the hostname behind the Access application is meant to reach this Worker.
  "workers_dev": false,
  "preview_urls": false,
  // The Admin is protected by Cloudflare Access, and the Worker verifies the signed
  // token itself (ADR 0070). A deployment without these two variables refuses every
  // request to the API instead of running unverified:
  // - ACCESS_TEAM_DOMAIN: <team>.cloudflareaccess.com
  // - ACCESS_AUDIENCE: the audience tag of the Access application for this Worker
  // The id below only serves local development. A deployed Worker needs a real
  // Hyperdrive configuration with query caching disabled, using the login of the
  // Admin role (a member of polaris_admin_runtime), which reads no table and runs only the Admin functions. Caching must stay off: the audit of every read and reveal is written by the function the query calls.
  // ADMIN_BILLING_HYPERDRIVE (the billing role's login, caching off) is added per environment for the
  // billing commands; without it they answer 503 and nothing is written (ADR 0073).
  "hyperdrive": [
    {
      "binding": "ADMIN_HYPERDRIVE",
      "id": "local-only",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/polaris"
    }
  ]
}

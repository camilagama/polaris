{
  "name": "@polaris/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:ui && wrangler deploy --dry-run --outdir dist",
    "build:ui": "bun build ./ui/main.ts --target=browser --format=esm --minify --outfile=src/ui/generated/admin.js.txt && cp ui/admin.css src/ui/generated/admin.css.txt",
    "check": "bun run typecheck",
    "dev": "bun run build:ui && wrangler dev --port 5175",
    "test": "bun run build:ui && cd ../.. && vitest run --project node --project admin-workerd apps/admin",
    "typecheck": "bun run build:ui && tsc --noEmit && tsc --noEmit -p ui && tsc --noEmit -p tsconfig.page-e2e.json"
  },
  "dependencies": {
    "@polaris/contracts": "workspace:*",
    "@polaris/db": "workspace:*",
    "@polaris/domain": "workspace:*",
    "@polaris/http-security": "workspace:*",
    "@polaris/observability": "workspace:*",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "wrangler": "4.147.0"
  }
}

{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "poc/pr11.ts",
        "poc/pr12-offline.ts",
        "e2e/**/*.e2e.ts",
        "e2e-pwa/**/*.e2e.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "worker/**/*.ts",
        "poc/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "apps/catalog": {
      "entry": ["src/routes/**/*.{ts,tsx}", "src/server/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}

{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/index.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/observability": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/http-security": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "poc/pr11.ts",
        "poc/pr12-offline.ts",
        "e2e/**/*.e2e.ts",
        "e2e-pwa/**/*.e2e.ts",
        "scripts/lighthouse-servers.ts",
        "vite.ui.ts"
      ],
      "ignore": ["src/ui/bklit/**"],
      "ignoreBinaries": ["openssl"],
      "ignoreDependencies": [
        "cloudflare",
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "tw-animate-css"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "worker/**/*.ts",
        "poc/**/*.ts",
        "e2e/**/*.ts",
        "e2e-pwa/**/*.ts",
        "real-devices/**/*.ts"
      ]
    },
    "apps/catalog": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/server/**/*.ts",
        "e2e/**/*.e2e.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/admin": {
      "entry": ["src/**/*.test.ts", "ui/main.ts", "ui/**/*.test.ts"],
      "project": ["src/**/*.ts", "ui/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}

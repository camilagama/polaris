{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Bklit UI as the registry distributes it (ADR 0103, amendment "Gráficos"): code of someone else, kept byte for byte so a
    // `shadcn add` shows its diff. Not linted nor formatted here; the adaptations of Polaris live in apps/web/src/ui/charts/.
    "includes": ["!apps/web/src/ui/bklit"]
  },
  "overrides": [
    {
      "includes": ["packages/domain/**"],
      "plugins": ["./scripts/biome-plugins/no-fast-check-direct-run.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // Property tests run through `assertProperty` (testing/property.ts), the one place that decides
                // the runs and the seed and prints the replay line (T-124a).
                "paths": {
                  "fast-check": {
                    "importNames": ["assert"],
                    "message": "Run a property with assertProperty from testing/property.ts, not fast-check's assert: runs, seed and the replay line are decided there."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "hono",
                      "hono/**",
                      "@orpc/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "drizzle-kit",
                      "@cloudflare/**",
                      "cloudflare:*",
                      "better-auth",
                      "better-auth/**",
                      "@better-auth/**",
                      "@aws-sdk/**",
                      "aws-sdk",
                      "@sentry/**",
                      "evlog",
                      "evlog/**",
                      "@polaris/observability",
                      "@polaris/observability/**",
                      "../../observability/**",
                      "../**/observability/**",
                      "asaas",
                      "asaas/**",
                      "@asaas/**",
                      "woovi",
                      "woovi/**",
                      "@woovi/**",
                      "@polaris/db",
                      "@polaris/db/**",
                      "@polaris/billing",
                      "@polaris/billing/**",
                      "../../db/**",
                      "../../billing/**"
                    ],
                    "message": "packages/domain must stay framework- and infrastructure-independent."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@polaris/db",
                      "@polaris/db/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "drizzle-kit",
                      "pg",
                      "pg/**",
                      "postgres",
                      "postgres/**",
                      "@neondatabase/**",
                      "@cloudflare/hyperdrive",
                      "../../db/**"
                    ],
                    "message": "packages/contracts must not import database or driver implementation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["evlog", "evlog/**"],
                    "message": "Server code logs through @polaris/observability: evlog directly would skip the redaction policy (ADR 0089)."
                  },
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "hono",
                      "hono/**",
                      "@orpc/**",
                      "@polaris/web",
                      "@polaris/web/**",
                      "../../../apps/**",
                      "../../apps/**"
                    ],
                    "message": "packages/db must not depend on the web app, the UI or the HTTP layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "!apps/web/src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@polaris/db",
                      "@polaris/db/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "pg/**",
                      "better-auth",
                      "better-auth/**",
                      "evlog",
                      "evlog/**",
                      "@polaris/observability",
                      "@polaris/observability/**",
                      "!@polaris/observability/redaction",
                      "../**/observability/src/**",
                      "../server/**",
                      "../../server/**",
                      "../../../server/**"
                    ],
                    "message": "Browser code must not import the database, the server layer or server-only libraries."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The public catalog reads only through the four public functions (ADR 0069). Its Workers test with a database
      // (T-121b) may name the driver to prove the role of the binding; the Worker's own files may not.
      "includes": [
        "apps/catalog/src/**",
        "!apps/catalog/src/**/*.workerd-db.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["evlog", "evlog/**"],
                    "message": "Server code logs through @polaris/observability: evlog directly would skip the redaction policy (ADR 0089)."
                  },
                  {
                    "group": [
                      "@polaris/db",
                      "@polaris/db/*",
                      "!@polaris/db/public-catalog-reader",
                      "@polaris/billing",
                      "@polaris/billing/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "pg/**",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "The public catalog must not import tenant data, billing, auth or a database driver: it reads only through the public catalog reader."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The Admin app reaches the database only through its own modules (ADR 0070):
      // never tenant data, billing, auth or a driver. Each Admin PR that adds a module lists it here.
      "includes": ["apps/admin/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["evlog", "evlog/**"],
                    "message": "Server code logs through @polaris/observability: evlog directly would skip the redaction policy (ADR 0089)."
                  },
                  {
                    "group": [
                      "@polaris/db",
                      "@polaris/db/*",
                      "!@polaris/db/platform-principal-repository",
                      "!@polaris/db/admin-diagnostics-repository",
                      "!@polaris/db/admin-support-repository",
                      "!@polaris/db/admin-incident-repository",
                      "!@polaris/db/admin-access-log-repository",
                      "!@polaris/db/admin-refund-window-repository",
                      "!@polaris/db/billing-store",
                      "@polaris/billing",
                      "@polaris/billing/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "pg/**",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "The Admin app must not import tenant data, billing, auth or a database driver: it reaches the database only through its own repositories."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // evlog is the logger's engine and runs with its own masking off (the Polaris policy masks in `emit`):
      // only packages/observability imports it.
      "includes": [
        "apps/web/src/server/**",
        "apps/web/worker/**",
        "packages/billing/src/**",
        "packages/http-security/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["evlog", "evlog/**"],
                    "message": "Server code logs through @polaris/observability: evlog directly would skip the redaction policy (ADR 0089)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Server code logs through @polaris/observability, whose redaction policy (ADR 0089) is the only
      // way a value reaches the log. A direct `console.*` skips it. Not covered on purpose: CLI scripts
      // and gates (`scripts/`, `real-devices/`), tests and e2e, and browser code (packages/ui, the catalog routes).
      "includes": [
        "apps/web/src/server/**",
        "apps/web/worker/**",
        "apps/admin/src/**",
        "apps/catalog/src/server/**",
        "apps/catalog/src/*.ts",
        "apps/catalog/src/*.tsx",
        "packages/*/src/**",
        "!packages/ui/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      // TanStack Start derives the URL from the file name ($param, [.] escapes)
      "includes": ["apps/catalog/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}

{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": ["packages/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "hono",
                      "hono/**",
                      "@orpc/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "drizzle-kit",
                      "@cloudflare/**",
                      "cloudflare:*",
                      "better-auth",
                      "better-auth/**",
                      "@better-auth/**",
                      "@aws-sdk/**",
                      "aws-sdk",
                      "@sentry/**",
                      "evlog",
                      "asaas",
                      "asaas/**",
                      "@asaas/**",
                      "woovi",
                      "woovi/**",
                      "@woovi/**",
                      "@polaris/db",
                      "@polaris/db/**",
                      "@polaris/billing",
                      "@polaris/billing/**",
                      "../../db/**",
                      "../../billing/**"
                    ],
                    "message": "packages/domain must stay framework- and infrastructure-independent."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@polaris/db",
                      "@polaris/db/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "drizzle-kit",
                      "pg",
                      "pg/**",
                      "postgres",
                      "postgres/**",
                      "@neondatabase/**",
                      "@cloudflare/hyperdrive",
                      "../../db/**"
                    ],
                    "message": "packages/contracts must not import database or driver implementation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "hono",
                      "hono/**",
                      "@orpc/**",
                      "@polaris/web",
                      "@polaris/web/**",
                      "../../../apps/**",
                      "../../apps/**"
                    ],
                    "message": "packages/db must not depend on the web app, the UI or the HTTP layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "!apps/web/src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@polaris/db",
                      "@polaris/db/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "pg/**",
                      "better-auth",
                      "better-auth/**",
                      "../server/**",
                      "../../server/**",
                      "../../../server/**"
                    ],
                    "message": "Browser code must not import the database, the server layer or server-only libraries."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The public catalog reads only through the four public functions (ADR 0069).
      "includes": ["apps/catalog/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@polaris/db",
                      "@polaris/db/*",
                      "!@polaris/db/public-catalog-reader",
                      "@polaris/billing",
                      "@polaris/billing/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "pg/**",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "The public catalog must not import tenant data, billing, auth or a database driver: it reads only through the public catalog reader."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // TanStack Start derives the URL from the file name ($param, [.] escapes)
      "includes": ["apps/catalog/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}

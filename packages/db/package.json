    "./tenant-audit": "./src/tenant-audit.ts",
    "./category-schema": "./src/schema/category.ts",
    "./category-repository": "./src/category-repository.ts",
    "./customer-schema": "./src/schema/customer.ts",
    "./customer-repository": "./src/customer-repository.ts",
    "./product-schema": "./src/schema/product.ts",
    "./payment-profile-schema": "./src/schema/payment-profile.ts",
    "./payment-profile-repository": "./src/payment-profile-repository.ts",
    "./sale-schema": "./src/schema/sale.ts",

{
  "name": "@polaris/db",
  "private": true,
  "type": "module",
  "exports": {
    "./auth-schema": "./src/schema/auth.ts",
    "./security-audit-schema": "./src/schema/security-audit.ts",
    "./organization-schema": "./src/schema/organization.ts",
    "./client": "./src/client.ts",
    "./schema/poc": "./src/schema/poc.ts",
    "./rls-poc-client": "./src/rls-poc-client.ts",
    "./rls-poc-gate": "./src/rls-poc-gate.ts"
  },
  "scripts": {
    "build": "bun run typecheck",
    "check": "bun run typecheck",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "poc": "bun scripts/poc.ts",
    "poc:rls:bootstrap": "bun scripts/bootstrap-rls-gate.ts",
    "poc:rls:verify": "bun scripts/verify-rls-gate.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.poc.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.5"
  }
}

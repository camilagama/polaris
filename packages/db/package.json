  "scripts": {
    "build": "bun run typecheck",
    "check": "bun run typecheck",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "poc": "bun scripts/poc.ts",
    "poc:gate2:verify": "bun scripts/verify-gate2-runtime.ts",
    "poc:rls:bootstrap": "bun scripts/bootstrap-rls-gate.ts",
    "poc:rls:verify": "bun scripts/verify-rls-gate.ts",
    "poc:tenant:prepare": "bun scripts/prepare-tenant-context-gate.ts",
    "poc:tenant:verify": "bun scripts/verify-tenant-context-gate.ts",
    "poc:inventory:verify": "bun scripts/verify-inventory-gate.ts",
    "poc:media:verify": "bun scripts/verify-media-gate.ts",
    "poc:media:upload:verify": "bun scripts/verify-media-upload-gate.ts",
    "poc:media:derivatives:verify": "bun scripts/verify-media-derivatives-gate.ts",
    "poc:customers:verify": "bun scripts/verify-customers-gate.ts",
    "poc:sales:verify": "bun scripts/verify-sales-aggregate-gate.ts",
    "poc:sales:transaction:verify": "bun scripts/verify-sale-transaction-gate.ts",
    "poc:sales:customer-link:verify": "bun scripts/verify-sale-customer-link-gate.ts",
    "poc:sales:cancellation:verify": "bun scripts/verify-sale-cancellation-gate.ts",
    "poc:sales:return:verify": "bun scripts/verify-sale-return-gate.ts",
    "poc:sales:dates:verify": "bun scripts/verify-sale-dates-gate.ts",
    "poc:gate4:verify": "bun scripts/verify-gate4-sales-core.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.poc.json"
  },
  "dependencies": {
    "@polaris/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.5"
  }
}

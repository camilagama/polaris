      "policies": {
        "organizations_active_tenant_select": {
          "name": "organizations_active_tenant_select",
          "as": "PERMISSIVE",
          "for": "SELECT",
          "to": ["polaris_pr11_runtime"],
          "using": "\n        \"organizations\".\"id\" = NULLIF(current_setting('app.organization_id', true), '')\n        AND \"organizations\".\"status\" = 'active'\n        AND EXISTS (\n          SELECT 1\n          FROM public.memberships AS membership_scope\n          WHERE membership_scope.organization_id = \"organizations\".\"id\"\n            AND membership_scope.user_id = NULLIF(current_setting('app.user_id', true), '')\n            AND membership_scope.status = 'active'\n        )\n      "
        },
        "organizations_context_insert": {
          "name": "organizations_context_insert",
          "as": "PERMISSIVE",
          "for": "INSERT",
          "to": ["polaris_pr11_runtime"],
          "withCheck": "\n        \"organizations\".\"id\" = NULLIF(current_setting('app.organization_id', true), '')\n        AND NULLIF(current_setting('app.user_id', true), '') IS NOT NULL\n        AND \"organizations\".\"status\" = 'active'\n      "
        }
      },
      "checkConstraints": {
        "organizations_status_check": {
          "name": "organizations_status_check",
          "value": "\"organizations\".\"status\" in ('active', 'suspended', 'closed')"
        },
        "organizations_currency_check": {
          "name": "organizations_currency_check",
          "value": "\"organizations\".\"currency\" = 'BRL'"
        }
